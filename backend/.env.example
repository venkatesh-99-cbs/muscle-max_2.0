DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

POSTGRES_DB=musclemax
POSTGRES_USER=musclemax
POSTGRES_PASSWORD=musclemax
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

CORS_ALLOWED_ORIGINS=http://localhost:5173

# OpenRouter — chat completions, with automatic fallback (see llm_client.py)
OPENROUTER_API_KEY=sk-or-your-key-here
OPENROUTER_PRIMARY_MODEL=openai/gpt-4o-mini
# Comma-separated, tried in order after the primary model:
OPENROUTER_FALLBACK_MODELS=anthropic/claude-3-haiku,google/gemini-flash-1.5
# Last-resort free-tier model — verify this ID is still live at
# https://openrouter.ai/models?max_price=0 before relying on it:
OPENROUTER_FREE_FALLBACK_MODEL=meta-llama/llama-3.2-3b-instruct:free

# Embeddings run locally — no key needed, just the model name:
EMBEDDING_MODEL=all-MiniLM-L6-v2
