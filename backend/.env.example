DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

POSTGRES_DB=musclemax
POSTGRES_USER=musclemax
POSTGRES_PASSWORD=musclemax
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

CORS_ALLOWED_ORIGINS=http://localhost:5173

# Ollama — local LLM chat completions (see llm_client.py)
# Make sure Ollama is running: ollama serve
# Pull a model: ollama pull mistral (or your preferred model)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=mistral

# Embeddings run locally — no key needed, just the model name:
EMBEDDING_MODEL=all-MiniLM-L6-v2
